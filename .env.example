# Application URL used by page.goto('/')
BASE_URL=https://www.tothenew.com/

# LambdaTest credentials (required only for cloud runs: npm run test:cloud)
LT_USERNAME=your_lambdatest_username
LT_ACCESS_KEY=your_lambdatest_access_key

# Optional LambdaTest metadata
LT_BUILD_NAME=TOTHENEW Playwright Build
LT_PROJECT_NAME=TOTHENEW Playwright Project

# Cloud runs need available desktop-automation minutes on your LambdaTest plan.
# If you see "Lifetime Minutes Exhausted", use local runs until quota resets:
#   npm test
#   npm run test:local:mobile

# Local debugging flags (used by npm run test:local:* scripts)
# HEADED=true          Open a visible Chrome window
# VISUAL_DEBUG=true    Step overlay + screenshots + trace/video on every step
# CLOUD=true           Include LambdaTest browser projects
